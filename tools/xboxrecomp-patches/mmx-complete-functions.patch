+import unittest
+
+from .disasm import Disassembler
+from .lifter import Lifter, _EFLAGS_PRESERVE
+from .translator import FunctionTranslator
+
+
+class MmxMovieLifterTest(unittest.TestCase):
+    def test_mmx_register_and_memory_forms_emit_real_operations(self):
+        cases = (
+            ("0f2dc1", "mm0 = MMX_CVTPS2PI(xmm1.f[0], xmm1.f[1]); /* cvtps2pi */"),
+            ("0f2d10", "mm2 = MMX_CVTPS2PI(MEMF(eax), MEMF((eax) + 4u)); /* cvtps2pi */"),
+            ("0f6bc1", "mm0 = MMX_PACKSSDW(mm0, mm1); /* packssdw */"),
+            ("0f6b10", "mm2 = MMX_PACKSSDW(mm2, MMX_MEM(eax)); /* packssdw */"),
+            ("0fe0c1", "mm0 = MMX_PAVGB(mm0, mm1); /* pavgb */"),
+            ("0fe008", "mm1 = MMX_PAVGB(mm1, MMX_MEM(eax)); /* pavgb */"),
+            ("0f6fc1", "mm0 = mm1; /* movq */"),
+            ("0f6f08", "mm1 = MMX_MEM(eax); /* movq */"),
+            ("0f7f00", "MMX_STORE(eax, mm0); /* movq */"),
+        )
+        for raw, expected in cases:
+            with self.subTest(raw=raw):
+                data = bytes.fromhex(raw)
+                instructions = Disassembler().disassemble_function(data, 0, len(data))
+                self.assertEqual(len(instructions), 1)
+                self.assertEqual(Lifter().lift_instruction(instructions[0]), [expected])
+
+    def test_new_mmx_handlers_do_not_claim_xmm_movq(self):
+        raw = bytes.fromhex("f30f7ec1")
+        instruction = Disassembler().disassemble_function(raw, 0, len(raw))[0]
+        lifted = Lifter().lift_instruction(instruction)
+        self.assertFalse(any("MMX_" in line for line in lifted))
+
+    def test_mmx_operations_preserve_integer_flags(self):
+        for mnemonic in ("cvtps2pi", "packssdw", "pavgb", "movq"):
+            self.assertIn(mnemonic, _EFLAGS_PRESERVE)
+
+    def test_incomplete_body_keeps_baseline_and_next_complete_body_enables(self):
+        translator = FunctionTranslator(b"", {})
+        for raw, enabled in (("0f6f000fefc00f7f00c3", False),
+                             ("0f6f000fe0c10f7f00c3", True)):
+            data = bytes.fromhex(raw)
+            translator._read_func_bytes = lambda start, end: data
+            code = translator.translate_function(0x1000, {"end": 0x1000 + len(data)})
+            self.assertEqual("MMX_STORE" in code, enabled)
+            self.assertEqual("MMX_MEM" in code, enabled)
+            if not enabled:
+                self.assertIn("/* SSE: movq mm0, qword ptr [eax] */", code)
+                self.assertIn("/* SSE: movq qword ptr [eax], mm0 */", code)
+
+    def test_incomplete_mmx_body_does_not_change_xmm_forms(self):
+        raw = bytes.fromhex("0fefc0f30f7ec1660f6bc1")
+        instructions = Disassembler().disassemble_function(raw, 0, len(raw))
+        lifter = Lifter()
+        expected = [lifter.lift_instruction(insn) for insn in instructions[1:]]
+        lifter.configure_mmx(instructions)
+        self.assertFalse(lifter.mmx_enabled)
+        self.assertEqual([lifter.lift_instruction(insn) for insn in instructions[1:]], expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
